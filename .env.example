# ---------------------------------------------------------------------------
# Restream Manager - example environment file
#
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to git (it is in .gitignore).
# ---------------------------------------------------------------------------

# ---- Web dashboard -------------------------------------------------------
# Bind to loopback by default. Only change this if you understand the
# consequences of exposing the dashboard to your network.
APP_HOST=127.0.0.1
APP_PORT=8787

# Optional dashboard authentication. If ADMIN_USERNAME is empty the dashboard
# is open to anyone who can reach APP_HOST:APP_PORT (fine for 127.0.0.1).
# The password is never stored in plaintext - it is hashed at startup.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Monitoring intervals -------------------------------------------------
# Deep source health check (ffprobe against the source URL), in seconds.
CHECK_INTERVAL_SECONDS=300
# Fast FFmpeg process/progress monitor, in seconds. Must be much smaller than
# CHECK_INTERVAL_SECONDS so a crashed FFmpeg is noticed almost immediately.
PROCESS_MONITOR_INTERVAL_SECONDS=5
# Consecutive deep-check failures before a channel is considered DOWN.
FAILURE_THRESHOLD=2
# If FFmpeg's reported output time does not advance for this many seconds the
# stream is treated as stalled even though the process is still alive.
STALL_TIMEOUT_SECONDS=60
# Timeout for a single ffprobe validation run.
PROBE_TIMEOUT_SECONDS=20

# ---- Restart / backoff ----------------------------------------------------
MAX_RESTART_DELAY_SECONDS=30
# Restart-loop protection: more than RESTART_WINDOW_THRESHOLD restarts inside
# RESTART_WINDOW_SECONDS puts the channel into a slow retry mode.
RESTART_WINDOW_SECONDS=600
RESTART_WINDOW_THRESHOLD=10
UNSTABLE_RESTART_DELAY_SECONDS=60

# ---- Backup sources (failover) --------------------------------------------
# The standby URLs themselves live on each channel (dashboard -> Edit ->
# "Backup source URLs"); these are the timings every channel shares.
FAILOVER_ENABLED=true
# Leave the primary once it has been down this long...
FAILOVER_AFTER_SECONDS=120
# ...or this many starts in a row died before proving stable. This is the
# "flapping" case: without it, a channel that comes up for 20s and dies keeps
# resetting the timer above and would never fail over.
FAILOVER_FAILURE_THRESHOLD=3
# A source must hold this long to count as genuinely working.
FAILOVER_MIN_STABLE_SECONDS=60
# Coming back to the primary is deliberately far stricter than leaving it: the
# switch costs viewers a glitch, so it must be worth it. Off by default - the
# channel page has a "Back to primary" button instead.
AUTO_FAILBACK=false
FAILBACK_AFTER_SECONDS=600
FAILBACK_PROBE_INTERVAL_SECONDS=60
# Final gate: pull the primary for real and require it to keep flowing. An
# ffprobe that passes only proves the first seconds parsed.
FAILBACK_SHADOW_SECONDS=90
# A primary that breaks again within this window doubles the healthy period
# required before the next failback, up to the maximum. This is what stops the
# channel ping-ponging between two half-working sources.
FAILBACK_PENALTY_WINDOW_SECONDS=900
FAILBACK_PENALTY_MAX_SECONDS=3600
# Once every source has been down this long, retry this slowly (it never gives
# up - it just stops hammering origins that are clearly not back yet).
ALL_DOWN_SLOW_AFTER_SECONDS=900
ALL_DOWN_RETRY_DELAY_SECONDS=300
# Ignore SLATE_MAX_SECONDS for channels pushing to a downstream RTMP server:
# if the slate stops there the push starves and services like YouTube end the
# broadcast within about a minute.
SLATE_KEEP_FOR_RTMP=true
# Seamless switching (enabled per channel) normalises every source to one
# encoding so the publisher can copy across a switch. Costs a re-encode.
SEAMLESS_VIDEO_SIZE=1280x720
SEAMLESS_FPS=25
RELAY_PORT_BASE=21000

# ---- FFmpeg ---------------------------------------------------------------
# Absolute paths are recommended on Windows, e.g.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Streaming defaults ---------------------------------------------------
# Base RTMP server used when a channel only defines a stream key, e.g.
# rtmp://server.example.com/live/  +  key "channel01"
#   =>  rtmp://server.example.com/live/channel01
DEFAULT_RTMP_SERVER=
# copy | transcode
DEFAULT_STREAM_MODE=copy
# Transcode profile defaults (only used in transcode mode)
TRANSCODE_VIDEO_BITRATE=2500k
TRANSCODE_AUDIO_BITRATE=128k
TRANSCODE_PRESET=veryfast

# ---- Source providers -----------------------------------------------------
# Providers are configured in the dashboard (/providers), not here - each one
# is a row in the database with its own JSON configuration, and its
# credentials live in the OS keychain rather than in this file.
#
# Built-in provider types:
#   manual       -> you paste a URL per channel
#   static_m3u8  -> fixed URL, URL template, or an M3U playlist
#   http_json    -> authenticated HTTP/JSON API (form/basic/bearer/cookie auth)
#
# See docs/CREATE_PROVIDER.md to add your own provider type.
#
# How long a resolved URL is considered fresh before it is resolved again.
SOURCE_CACHE_TTL_SECONDS=1800
# User-Agent used for source HTTP requests and by FFmpeg.
SOURCE_USER_AGENT=Mozilla/5.0 (compatible; RestreamManager/1.0)

# ---- Telegram notifications ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Interface ------------------------------------------------------------
# Dashboard language: th (Thai) or en (English). Switchable in the top-right
# corner of the dashboard at any time.
UI_LANGUAGE=th

# ---- Privacy / logging ----------------------------------------------------
# When false, the dashboard list view masks token/signature query parameters
# in source URLs.
SHOW_FULL_SOURCE_URL=false
LOG_LEVEL=INFO
